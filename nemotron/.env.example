# NVIDIA NIM API Configuration
# Get your key at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model ID (optional — defaults to nvidia/llama-3.1-nemotron-ultra-253b-v1)
NVIDIA_NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
