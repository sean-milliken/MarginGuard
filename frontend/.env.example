# npm run dev explicitly enables local demo authentication.
# For deployment, keep mock mode false and use Cognito values from CDK outputs.
VITE_MOCK_MODE=false
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_AWS_REGION=us-east-1
# Local development uses /api via Vite proxy. Deployment uses the CDK ApiUrl.
VITE_API_URL=/api
