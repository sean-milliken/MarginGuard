# Optional server-side NVIDIA credentials. Never use VITE_ for secrets.
NVIDIA_API_KEY=
# NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# ARN of the Secrets Manager secret holding the NVIDIA API key (used by deploy-infra.sh)
NEMOTRON_SECRET_ARN=

# FRED API Key (Federal Reserve Economic Data)
# Obtain a free API key from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ARN of the Secrets Manager secret holding the FRED API key (used by deploy-infra.sh)
FRED_SECRET_ARN=

PORT=3001
HOST=127.0.0.1
